# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/teamProject?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=test
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Server / frontend
SERVER_PORT=8081
FRONTEND_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:8081/api/v1

# JWT (use a long, random secret outside local development)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECONDS=3600
JWT_REFRESH_SECONDS=1209600
AUTH_SECURE_COOKIE=false

# Email
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@team-project.local
MAIL_ENABLED=false
MAIL_VERIFICATION_MINUTES=10
PASSWORD_RESET_MINUTES=30

# OAuth2
OAUTH2_GOOGLE_CLIENT_ID=disabled
OAUTH2_GOOGLE_CLIENT_SECRET=disabled
OAUTH2_KAKAO_CLIENT_ID=disabled
OAUTH2_KAKAO_CLIENT_SECRET=disabled